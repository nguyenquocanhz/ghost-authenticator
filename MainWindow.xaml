<Window x:Class="AuthenticatorDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Ghost Authenticator" Height="600" Width="850" MinWidth="600" MinHeight="450"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource WinBg}" Icon="asset/93cca52a-7f6f-40dd-8dba-7ba23fdcd6dc.png"
        AllowDrop="True" Drop="Window_Drop">
    
    <Window.Resources>
        <!-- Default Light Theme Colors -->
        <SolidColorBrush x:Key="WinBg" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="HeaderBg" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#0F172A"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#475569"/>
        <SolidColorBrush x:Key="PrimaryBlue" Color="#1A73E8"/>
        <SolidColorBrush x:Key="HoverBg" Color="#F1F5F9"/>
        <SolidColorBrush x:Key="ModalBg" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="InputBg" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="DangerRed" Color="#DC2626"/>

        <!-- Custom Scrollbar Template to match Google minimal style -->
        <Style x:Key="MinimalScrollbar" TargetType="{x:Type ScrollViewer}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollViewer}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ScrollContentPresenter Grid.Column="0"/>
                            <ScrollBar Grid.Column="1" x:Name="PART_VerticalScrollBar"
                                       Value="{TemplateBinding VerticalOffset}"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                                       Width="6" Margin="2,0,0,0" Background="Transparent"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- High Contrast Primary Button Style -->
        <Style x:Key="PrimaryBtn" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="#1A73E8"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1557B0"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0D47A1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- High Contrast Secondary Button Style -->
        <Style x:Key="SecondaryBtn" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="BorderBrush" Value="#1A73E8"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E2E8F0"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#1557B0"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#CBD5E1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- 1. Authentication / Lock Screen Grid -->
        <Grid x:Name="AuthGrid" Visibility="Visible" Background="{DynamicResource WinBg}">
            <!-- 0. First Launch Welcome Onboarding Choice Panel -->
            <Border x:Name="WelcomeChoicePanel" Visibility="Collapsed" Background="{DynamicResource ModalBg}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Width="440" Height="Auto" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="28">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="25" ShadowDepth="5" Opacity="0.1"/>
                </Border.Effect>
                <StackPanel>
                    <Image Source="asset/93cca52a-7f6f-40dd-8dba-7ba23fdcd6dc.png" Width="64" Height="64" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                    <TextBlock Text="Chào mừng tới Ghost Authenticator" FontSize="19" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                    <TextBlock Text="Vui lòng chọn khởi tạo kho bảo mật mới hoặc khôi phục dữ liệu 2FA của bạn." FontSize="12" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,24"/>

                    <!-- Choice 1: Create New -->
                    <Button x:Name="BtnChoiceCreateNew" Style="{StaticResource PrimaryBtn}" Margin="0,0,0,12" Click="BtnChoiceCreateNew_Click">
                        <Grid Width="340">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="White" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Tạo Kho Mới (Create New Vault)" FontSize="14" FontWeight="Bold" Foreground="White"/>
                                <TextBlock Text="Thiết lập mật khẩu chính mới cho ứng dụng" FontSize="11" Foreground="#F1F5F9" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Button>

                    <!-- Choice 2: Restore Backup -->
                    <Button x:Name="BtnChoiceRestore" Style="{StaticResource SecondaryBtn}" Click="BtnChoiceRestore_Click">
                        <Grid Width="340">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE8B6;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#1A73E8" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Khôi Phục Dữ Liệu (Restore Backup)" FontSize="14" FontWeight="Bold" Foreground="#0F172A"/>
                                <TextBlock Text="Phục hồi từ file .ghostbak, JSON hoặc CSV cũ" FontSize="11" Foreground="#475569" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Setup Password View -->
            <Border x:Name="SetupPasswordPanel" Visibility="Collapsed" Background="{DynamicResource ModalBg}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Width="400" Height="Auto" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="28">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="25" ShadowDepth="5" Opacity="0.1"/>
                </Border.Effect>
                <StackPanel>
                    <!-- Icon Shield -->
                    <Image Source="asset/93cca52a-7f6f-40dd-8dba-7ba23fdcd6dc.png" Width="54" Height="54" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                    <TextBlock Text="Thiết lập mật khẩu chính" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                    <TextBlock Text="Mật khẩu chính dùng để bảo mật và mã hóa toàn bộ dữ liệu 2FA của bạn." FontSize="12" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,24"/>

                    <!-- Password -->
                    <TextBlock Text="Mật khẩu mới (Master Password)" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,6"/>
                    <PasswordBox x:Name="TxtNewPassword" PasswordChar="●" Padding="10,8" BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource InputBg}" Foreground="{DynamicResource TextPrimary}" BorderThickness="1" KeyDown="TxtNewPassword_KeyDown" Margin="0,0,0,14"/>

                    <!-- Confirm Password -->
                    <TextBlock Text="Xác nhận mật khẩu" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,6"/>
                    <PasswordBox x:Name="TxtConfirmPassword" PasswordChar="●" Padding="10,8" BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource InputBg}" Foreground="{DynamicResource TextPrimary}" BorderThickness="1" KeyDown="TxtConfirmPassword_KeyDown" Margin="0,0,0,20"/>

                    <Button Content="Thiết lập mật khẩu" Background="{DynamicResource PrimaryBlue}" Foreground="White" BorderThickness="0" Padding="14,10" FontWeight="Medium" FontSize="14" Click="BtnSetupPassword_Click">
                        <Button.Resources>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Unlock App View -->
            <Border x:Name="UnlockPanel" Visibility="Collapsed" Background="{DynamicResource ModalBg}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Width="400" Height="Auto" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="28">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="25" ShadowDepth="5" Opacity="0.1"/>
                </Border.Effect>
                <StackPanel>
                    <!-- Icon Lock -->
                    <Image Source="asset/93cca52a-7f6f-40dd-8dba-7ba23fdcd6dc.png" Width="54" Height="54" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                    <TextBlock Text="Mở khóa ứng dụng" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                    <TextBlock Text="Nhập mật khẩu chính để giải mã danh sách tài khoản 2FA." FontSize="12" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,24"/>

                    <!-- Password Input -->
                    <TextBlock Text="Mật khẩu chính (Master Password)" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,6"/>
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <PasswordBox x:Name="TxtMasterPassword" Grid.Column="0" PasswordChar="●" Padding="10,8" BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource InputBg}" Foreground="{DynamicResource TextPrimary}" BorderThickness="1" KeyDown="TxtMasterPassword_KeyDown"/>
                        <Button x:Name="BtnHelloUnlock" Grid.Column="1" Content="&#xE1D6;" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="38" Margin="8,0,0,0" Padding="0" Background="Transparent" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Foreground="{DynamicResource TextPrimary}" Click="BtnHelloUnlock_Click" ToolTip="Mở khóa bằng Windows Hello (FaceID / Vân tay)" Visibility="Collapsed">
                            <Button.Resources>
                                <Style TargetType="{x:Type Border}">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </Grid>

                    <Button Content="Mở khóa" Background="{DynamicResource PrimaryBlue}" Foreground="White" BorderThickness="0" Padding="14,10" FontWeight="Medium" FontSize="14" Click="BtnUnlock_Click">
                        <Button.Resources>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 2. Main Application Grid -->
        <Grid x:Name="MainAppGrid" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Top Header -->
                <RowDefinition Height="Auto"/> <!-- Progress line -->
                <RowDefinition Height="*"/>    <!-- Account rows list -->
            </Grid.RowDefinitions>

        <!-- 1. Top Header -->
        <Border Grid.Row="0" Background="{DynamicResource HeaderBg}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="20,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/> <!-- Brand -->
                    <ColumnDefinition Width="*"/>    <!-- Spacer / Search -->
                    <ColumnDefinition Width="Auto"/> <!-- Actions -->
                </Grid.ColumnDefinitions>

                <!-- Brand logo and name -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Logo Image -->
                    <Image Source="asset/93cca52a-7f6f-40dd-8dba-7ba23fdcd6dc.png" Width="20" Height="20" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Ghost Authenticator" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Search box + Add button -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,15,0">
                    <!-- Search input field -->
                    <Grid Width="220" Margin="0,0,10,0">
                        <TextBox x:Name="SearchBox" Padding="30,7,10,7" BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource InputBg}" Foreground="{DynamicResource TextPrimary}" BorderThickness="1" SelectionBrush="{DynamicResource PrimaryBlue}" TextChanged="SearchBox_TextChanged" KeyDown="SearchBox_KeyDown">
                            <TextBox.Resources>
                                <Style TargetType="{x:Type Border}">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </TextBox.Resources>
                        </TextBox>
                        <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10,0,0,0" IsHitTestVisible="False"/>
                        <TextBlock Text="Tìm kiếm..." Foreground="{DynamicResource TextSecondary}" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="30,0,0,0" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <!-- Add Account Button -->
                    <Button x:Name="BtnAdd" Background="{DynamicResource PrimaryBlue}" Foreground="White" BorderThickness="0" Padding="12,7" FontWeight="Medium" Click="BtnAdd_Click" Margin="0,0,8,0">
                        <Button.Resources>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE109;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,1,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Thêm thủ công" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Quick QR Scan Button -->
                    <Button x:Name="BtnQuickQr" Background="Transparent" BorderBrush="{DynamicResource PrimaryBlue}" BorderThickness="1" Foreground="{DynamicResource PrimaryBlue}" Padding="10,7" FontWeight="Medium" Click="BtnScanScreenQr_Click" ToolTip="Quét mã QR trực tiếp từ màn hình">
                        <Button.Resources>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xED14;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,1,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Quét QR Màn Hình" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Icon Action Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Backup -->
                    <Button x:Name="BtnBackup" ToolTip="Sao lưu / Nhập dữ liệu" Background="Transparent" BorderThickness="0" Width="34" Height="34" Margin="0,0,4,0" Click="BtnBackup_Click">
                        <TextBlock Text="&#xEA35;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>

                    <!-- Theme Toggle -->
                    <Button x:Name="BtnTheme" ToolTip="Giao diện Sáng/Tối" Background="Transparent" BorderThickness="0" Width="34" Height="34" Margin="0,0,4,0" Click="BtnTheme_Click">
                        <TextBlock x:Name="ThemeIcon" Text="&#xE708;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>

                    <!-- About -->
                    <Button x:Name="BtnAbout" ToolTip="Thông tin ứng dụng" Background="Transparent" BorderThickness="0" Width="34" Height="34" Click="BtnAbout_Click">
                        <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. Sliding Progress Line -->
        <ProgressBar Grid.Row="1" x:Name="TimeProgress" Height="2.5" Minimum="0" Maximum="30" Value="30" Foreground="{DynamicResource PrimaryBlue}" Background="Transparent" BorderThickness="0"/>

        <!-- 3. Account Rows List -->
        <ListBox Grid.Row="2" x:Name="AccountsList" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Padding="0,10" SelectionMode="Single" HorizontalContentAlignment="Stretch">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                    <Setter Property="Padding" Value="24,14"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource HoverBg}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/> <!-- Issuer Badge -->
                            <ColumnDefinition Width="*"/>    <!-- Name details -->
                            <ColumnDefinition Width="Auto"/> <!-- OTP Pin & Actions -->
                        </Grid.ColumnDefinitions>

                        <!-- Left Badge -->
                        <Border Grid.Column="0" Background="{DynamicResource HoverBg}" CornerRadius="6" Padding="8,4" VerticalAlignment="Center" Margin="0,0,15,0">
                            <TextBlock Text="{Binding IssuerAbbr}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}"/>
                        </Border>

                        <!-- Middle Account Info -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                            <TextBlock Text="{Binding Issuer}" FontSize="15" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}" Margin="0,0,2,0"/>
                            <TextBlock Text="{Binding Label}" FontSize="13" Foreground="{DynamicResource TextSecondary}"/>
                        </StackPanel>

                        <!-- Right OTP displaying and actions -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Large Pin Code -->
                            <TextBlock Text="{Binding FormattedPin}" FontSize="28" FontWeight="Medium" Foreground="{DynamicResource PrimaryBlue}" Margin="0,0,12,0" VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonDown="PinCode_Click"/>
                            
                            <!-- Seconds Remaining Text Badge -->
                            <Border Background="{DynamicResource HoverBg}" CornerRadius="10" Padding="8,3" Margin="0,0,16,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding RemainingSecondsText}" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource TextSecondary}"/>
                            </Border>
                            
                            <!-- Action Buttons hidden until hover -->
                            <StackPanel x:Name="ActionPanel" Orientation="Horizontal" VerticalAlignment="Center" Opacity="0">
                                <!-- Copy Button -->
                                <Button Background="Transparent" BorderThickness="0" Margin="0,0,8,0" Click="BtnCopyRow_Click" Tag="{Binding}" Width="30" Height="30" ToolTip="Sao chép OTP">
                                    <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource TextSecondary}"/>
                                </Button>
                                <!-- View Secret Button -->
                                <Button Background="Transparent" BorderThickness="0" Margin="0,0,8,0" Click="BtnViewSecret_Click" Tag="{Binding}" Width="30" Height="30" ToolTip="Xem Khóa Bí Mật (Secret Key)">
                                    <TextBlock Text="&#xE7B3;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource TextSecondary}"/>
                                </Button>
                                <!-- Delete Button -->
                                <Button Background="Transparent" BorderThickness="0" Click="BtnDeleteRow_Click" Tag="{Binding}" Width="30" Height="30" ToolTip="Xóa tài khoản">
                                    <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource DangerRed}"/>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                    <DataTemplate.Triggers>
                        <!-- Show buttons on hover -->
                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                            <Setter TargetName="ActionPanel" Property="Opacity" Value="1"/>
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Empty State Placeholder -->
        <StackPanel Grid.Row="2" x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
            <TextBlock Text="&#xEA39;" FontFamily="Segoe MDL2 Assets" FontSize="60" Foreground="{DynamicResource BorderBrush}" HorizontalAlignment="Center" Margin="0,0,0,15"/>
            <TextBlock Text="Chưa có tài khoản 2FA nào được lưu." FontSize="15" FontWeight="Medium" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" Margin="0,0,0,5"/>
            <TextBlock Text="Nhấp vào nút '+ Thêm tài khoản' ở trên để cấu hình." FontSize="13" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- Add Modal Overlay -->
        <Grid Grid.Row="0" Grid.RowSpan="3" x:Name="AddModal" Visibility="Collapsed">
            <!-- Semi-transparent Background -->
            <Border Background="#66000000" MouseLeftButtonDown="ModalBackdrop_Click"/>
            
            <!-- Modal Body -->
            <Border Background="{DynamicResource ModalBg}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Width="420" Height="Auto" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="24">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="25" ShadowDepth="5" Opacity="0.15"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Title -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <TextBlock Text="Thêm tài khoản 2FA" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                        <Button x:Name="BtnCloseModal" Background="Transparent" BorderThickness="0" HorizontalAlignment="Right" Click="BtnCloseModal_Click">
                            <TextBlock Text="&#xE10A;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                        </Button>
                    </Grid>

                    <!-- Quick QR Import Section -->
                    <Border Grid.Row="1" Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="🖼️ Thêm nhanh từ Mã QR Code" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="📷 Quét màn hình" Style="{StaticResource PrimaryBtn}" Padding="8,6" FontSize="11" Click="BtnScanScreenQr_Click"/>
                                <Button Grid.Column="2" Content="🖼️ Chọn ảnh QR" Style="{StaticResource SecondaryBtn}" Padding="8,6" FontSize="11" Click="BtnImportQrImage_Click"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Service name -->
                    <StackPanel Grid.Row="2" Margin="0,0,0,14">
                        <TextBlock Text="Tên dịch vụ (ví dụ: Google, HostViet)" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,6"/>
                        <TextBox x:Name="InputIssuer" Padding="10,8" BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource InputBg}" Foreground="{DynamicResource TextPrimary}" BorderThickness="1">
                            <TextBox.Resources>
                                <Style TargetType="{x:Type Border}">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </TextBox.Resources>
                        </TextBox>
                    </StackPanel>

                    <!-- Account label -->
                    <StackPanel Grid.Row="3" Margin="0,0,0,14">
                        <TextBlock Text="Tên tài khoản (Email, nhãn)" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,6"/>
                        <TextBox x:Name="InputLabel" Padding="10,8" BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource InputBg}" Foreground="{DynamicResource TextPrimary}" BorderThickness="1">
                            <TextBox.Resources>
                                <Style TargetType="{x:Type Border}">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </TextBox.Resources>
                        </TextBox>
                    </StackPanel>

                    <!-- Secret Key -->
                    <StackPanel Grid.Row="4" Margin="0,0,0,20">
                        <TextBlock Text="Khóa bí mật của bạn (Secret Key)" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,6"/>
                        <TextBox x:Name="InputSecret" Padding="10,8" BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource InputBg}" Foreground="{DynamicResource TextPrimary}" BorderThickness="1">
                            <TextBox.Resources>
                                <Style TargetType="{x:Type Border}">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </TextBox.Resources>
                        </TextBox>
                    </StackPanel>

                    <!-- Submit Button -->
                    <Button Grid.Row="5" x:Name="BtnSubmitAdd" Content="Thêm thủ công" Background="{DynamicResource PrimaryBlue}" Foreground="White" BorderThickness="0" Padding="14,10" FontWeight="Medium" FontSize="14" Click="BtnSubmitAdd_Click">
                        <Button.Resources>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </Grid>
            </Border>
        </Grid>

        <!-- Backup & Bulk Import Modal Overlay -->
        <Grid Grid.Row="0" Grid.RowSpan="3" x:Name="BackupImportModal" Visibility="Collapsed">
            <!-- Semi-transparent Background -->
            <Border Background="#66000000" MouseLeftButtonDown="BackupImportBackdrop_Click"/>
            
            <!-- Modal Body -->
            <Border Background="{DynamicResource ModalBg}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Width="480" Height="Auto" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="24">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="25" ShadowDepth="5" Opacity="0.15"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Title / Close -->
                        <RowDefinition Height="Auto"/> <!-- Tab Headers -->
                        <RowDefinition Height="*"/>    <!-- Tab Content -->
                    </Grid.RowDefinitions>
                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <TextBlock Text="Sao lưu &amp; Nhập dữ liệu hàng loạt" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                        <Button x:Name="BtnCloseBackupImport" Background="Transparent" BorderThickness="0" HorizontalAlignment="Right" Click="BtnCloseBackupImport_Click">
                            <TextBlock Text="&#xE10A;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                        </Button>
                    </Grid>

                    <!-- Tab Buttons -->
                    <UniformGrid Grid.Row="1" Columns="5" Margin="0,0,0,18">
                        <Button x:Name="BtnTabQr" Content="Quét Mã QR" Padding="6,6" Background="Transparent" BorderThickness="0,0,0,2" BorderBrush="{DynamicResource PrimaryBlue}" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold" Click="BtnTab_Click" Tag="QR"/>
                        <Button x:Name="BtnTabJson" Content="Sao lưu" Padding="6,6" Background="Transparent" BorderThickness="0" BorderBrush="Transparent" Foreground="{DynamicResource TextSecondary}" Click="BtnTab_Click" Tag="JSON"/>
                        <Button x:Name="BtnTabCsv" Content="CSV / TXT" Padding="6,6" Background="Transparent" BorderThickness="0" BorderBrush="Transparent" Foreground="{DynamicResource TextSecondary}" Click="BtnTab_Click" Tag="CSV"/>
                        <Button x:Name="BtnTabSheet" Content="Google Sheet" Padding="6,6" Background="Transparent" BorderThickness="0" BorderBrush="Transparent" Foreground="{DynamicResource TextSecondary}" Click="BtnTab_Click" Tag="SHEET"/>
                        <Button x:Name="BtnTabTrash" Content="Thùng rác" Padding="6,6" Background="Transparent" BorderThickness="0" BorderBrush="Transparent" Foreground="{DynamicResource TextSecondary}" Click="BtnTab_Click" Tag="TRASH"/>
                    </UniformGrid>

                    <!-- Tab Content Panel -->
                    <Grid Grid.Row="2" MinHeight="220" VerticalAlignment="Top">
                        <!-- Tab 0: QR Code Scanner & Image Import -->
                        <StackPanel x:Name="PanelTabQr" Visibility="Visible">
                            <TextBlock Text="Nhập tài khoản 2FA bằng Mã QR (QR Code Scanner)" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,6"/>
                            <TextBlock Text="Quét trực tiếp mã QR 2FA đang hiển thị trên màn hình máy tính hoặc tải lên file ảnh mã QR." FontSize="11" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,14"/>

                            <Border Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="📷 Quét mã QR trực tiếp trên màn hình" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,4"/>
                                    <TextBlock Text="Tự động chụp màn hình và trích xuất khóa 2FA từ trang web (Facebook, Google, Discord...)" FontSize="11" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                    <Button Content="Quét QR trên màn hình" Style="{StaticResource PrimaryBtn}" Padding="10,8" Click="BtnScanScreenQr_Click"/>
                                </StackPanel>
                            </Border>

                            <Border Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="🖼️ Nhập mã QR từ File Ảnh" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,4"/>
                                    <TextBlock Text="Chọn tệp tin hình ảnh (.png, .jpg, .jpeg, .bmp) chứa mã QR 2FA" FontSize="11" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                    <Button Content="Chọn file ảnh QR" Style="{StaticResource SecondaryBtn}" Padding="10,8" Click="BtnImportQrImage_Click"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Tab 1: Encrypted & JSON Backup -->
                        <StackPanel x:Name="PanelTabJson" Visibility="Collapsed">
                            <TextBlock Text="Sao lưu an toàn (Encrypted .ghostbak &amp; JSON)" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,6"/>
                            <TextBlock Text="Khuyến nghị: Xuất file sao lưu mã hóa (.ghostbak) được bảo vệ bằng mật khẩu để chống lộ mã 2FA khi lưu trữ trên Cloud/USB." FontSize="11" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,14"/>
                            
                            <!-- Encrypted Backup Section -->
                            <Border Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="🔒 Sao lưu mã hóa (.ghostbak)" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Content="Xuất file .ghostbak" Background="{DynamicResource PrimaryBlue}" Foreground="White" BorderThickness="0" Padding="10,8" FontWeight="Medium" FontSize="12" Click="BtnExportGhostBak_Click">
                                            <Button.Resources>
                                                <Style TargetType="{x:Type Border}">
                                                    <Setter Property="CornerRadius" Value="6"/>
                                                </Style>
                                            </Button.Resources>
                                        </Button>
                                        <Button Grid.Column="2" Content="Nhập file .ghostbak" Background="Transparent" BorderBrush="{DynamicResource PrimaryBlue}" Foreground="{DynamicResource PrimaryBlue}" BorderThickness="1" Padding="10,8" FontWeight="Medium" FontSize="12" Click="BtnImportGhostBak_Click">
                                            <Button.Resources>
                                                <Style TargetType="{x:Type Border}">
                                                    <Setter Property="CornerRadius" Value="6"/>
                                                </Style>
                                            </Button.Resources>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Plain JSON Section -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="Xuất JSON (Bản rõ)" Background="Transparent" BorderBrush="{DynamicResource BorderBrush}" Foreground="{DynamicResource TextSecondary}" BorderThickness="1" Padding="10,6" FontSize="11" Click="BtnExportJson_Click" ToolTip="Cảnh báo: Bản rõ JSON không mã hóa!">
                                    <Button.Resources>
                                        <Style TargetType="{x:Type Border}">
                                            <Setter Property="CornerRadius" Value="6"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                                <Button Grid.Column="2" Content="Nhập JSON (Bản rõ)" Background="Transparent" BorderBrush="{DynamicResource BorderBrush}" Foreground="{DynamicResource TextSecondary}" BorderThickness="1" Padding="10,6" FontSize="11" Click="BtnImportJson_Click">
                                    <Button.Resources>
                                        <Style TargetType="{x:Type Border}">
                                            <Setter Property="CornerRadius" Value="6"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </Grid>
                        </StackPanel>

                        <!-- Tab 2: CSV/TXT Bulk Import -->
                        <StackPanel x:Name="PanelTabCsv" Visibility="Collapsed">
                            <TextBlock Text="Nhập hàng loạt từ tệp tin CSV / TXT" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8"/>
                            <TextBlock Text="Định dạng hỗ trợ:&#x0a;• otpauth://totp/Label?secret=KEY (Google Authenticator URI)&#x0a;• TênDịchVụ,Nhãn,KhóaBíMật (Ngăn cách bởi dấu phẩy, chấm phẩy hoặc tab)." FontSize="12" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,15"/>
                            
                            <Button Content="Chọn File (.csv, .txt)" Background="{DynamicResource PrimaryBlue}" Foreground="White" BorderThickness="0" Padding="14,10" FontWeight="Medium" FontSize="13" Click="BtnImportCsvFile_Click">
                                <Button.Resources>
                                    <Style TargetType="{x:Type Border}">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </StackPanel>

                        <!-- Tab 3: Google Sheet Connection -->
                        <StackPanel x:Name="PanelTabSheet" Visibility="Collapsed">
                            <TextBlock Text="Nhập từ liên kết CSV Google Sheet công khai" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,4"/>
                            
                            <!-- Small Help link/instruction -->
                            <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,12">
                                <Run Text="Hướng dẫn: Trên Google Sheet của bạn, chọn "/><Run FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Text="Tệp"/><Run Text=" -> "/><Run FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Text="Chia sẻ"/><Run Text=" -> "/><Run FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Text="Xuất bản lên web"/><Run Text=" -> Chọn định dạng "/><Run FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Text="CSV"/><Run Text=" -> Nhấn Xuất bản và sao chép liên kết dán vào ô dưới."/>
                            </TextBlock>

                            <TextBlock Text="Đường dẫn Google Sheet CSV (URL):" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,6"/>
                            <TextBox x:Name="InputSheetUrl" Padding="10,8" BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource InputBg}" Foreground="{DynamicResource TextPrimary}" BorderThickness="1" Margin="0,0,0,14">
                                <TextBox.Resources>
                                    <Style TargetType="{x:Type Border}">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </TextBox.Resources>
                            </TextBox>

                            <Button Content="Đồng bộ từ Google Sheet" Background="{DynamicResource PrimaryBlue}" Foreground="White" BorderThickness="0" Padding="14,10" FontWeight="Medium" FontSize="13" Click="BtnImportFromSheet_Click">
                                <Button.Resources>
                                    <Style TargetType="{x:Type Border}">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </StackPanel>

                        <!-- Tab 4: Trash Recycle Bin -->
                        <Grid x:Name="PanelTabTrash" Visibility="Collapsed" Margin="0,0,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <TextBlock Grid.Row="0" Text="Khôi phục tài khoản đã xóa" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8"/>
                            
                            <ListBox Grid.Row="1" x:Name="TrashList" Height="140" Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" ScrollViewer.VerticalScrollBarVisibility="Auto" Margin="0,0,0,10">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Padding" Value="4"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Width="410">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Issuer}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}"/>
                                                <TextBlock Text="{Binding Label}" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <!-- Restore Button -->
                                                <Button Background="Transparent" BorderThickness="0" Click="BtnRestoreTrash_Click" Tag="{Binding}" Width="28" Height="28" Margin="0,0,6,0" ToolTip="Khôi phục tài khoản">
                                                    <TextBlock Text="&#xE7A7;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource PrimaryBlue}"/>
                                                </Button>
                                                <!-- Permanently Delete Button -->
                                                <Button Background="Transparent" BorderThickness="0" Click="BtnDeleteTrashPermanent_Click" Tag="{Binding}" Width="28" Height="28" ToolTip="Xóa vĩnh viễn">
                                                    <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource DangerRed}"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            
                            <Grid Grid.Row="2" Margin="0,2,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="* Các tài khoản đã xóa có thể được khôi phục tại đây." FontSize="11" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Content="Dọn thùng rác" Background="Transparent" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Foreground="{DynamicResource DangerRed}" Padding="10,6" FontSize="11" Click="BtnEmptyTrash_Click">
                                    <Button.Resources>
                                        <Style TargetType="{x:Type Border}">
                                            <Setter Property="CornerRadius" Value="6"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- About Modal Overlay -->
        <Grid Grid.Row="0" Grid.RowSpan="3" x:Name="AboutModal" Visibility="Collapsed">
            <!-- Semi-transparent Background -->
            <Border Background="#66000000" MouseLeftButtonDown="AboutBackdrop_Click"/>
            
            <!-- Modal Body -->
            <Border Background="{DynamicResource ModalBg}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Width="440" Height="Auto" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="24">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="25" ShadowDepth="5" Opacity="0.15"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Title / Close -->
                        <RowDefinition Height="Auto"/> <!-- App Info / Dev -->
                        <RowDefinition Height="Auto"/> <!-- Security & Backup -->
                        <RowDefinition Height="Auto"/> <!-- Policy & License -->
                        <RowDefinition Height="Auto"/> <!-- Footer Copyright -->
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <TextBlock Text="Thông tin ứng dụng" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                        <Button x:Name="BtnCloseAbout" Background="Transparent" BorderThickness="0" HorizontalAlignment="Right" Click="BtnCloseAbout_Click">
                            <TextBlock Text="&#xE10A;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                        </Button>
                    </Grid>

                    <!-- Dev Info -->
                    <StackPanel Grid.Row="1" Margin="0,0,0,14">
                        <TextBlock Text="Nhà phát triển:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
                        <TextBlock Text="Nguyen Quoc Anh" FontSize="14" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="Phiên bản: 1.0.0 (Desktop Standard)" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0"/>
                    </StackPanel>

                    <!-- Security Info & Backup link -->
                    <StackPanel Grid.Row="2" Margin="0,0,0,14">
                        <TextBlock Text="Công nghệ bảo mật:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
                        <TextBlock Text="Mã hóa bảo mật PBKDF2 + AES-256" FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="Dữ liệu khóa bí mật được mã hóa hoàn toàn cục bộ và chỉ có thể giải mã khi bạn nhập đúng mật khẩu Master." FontSize="12" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                        <CheckBox x:Name="ChkWindowsHello" Content="Mở khóa bằng Windows Hello (FaceID / Vân tay)" Checked="ChkWindowsHello_Checked" Unchecked="ChkWindowsHello_Unchecked" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,8,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Policy & License -->
                    <StackPanel Grid.Row="3" Margin="0,0,0,16">
                        <TextBlock Text="Chính sách bảo mật &amp; Bản quyền:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
                        <TextBlock Text="• Dữ liệu được lưu trữ hoàn toàn cục bộ (100% Offline)." FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,2"/>
                        <TextBlock Text="• Không thu thập, không truyền tải bất kỳ thông tin nào ra ngoài." FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,2"/>
                        <TextBlock Text="• Giấy phép: Bản quyền thuộc về Nguyen Quoc Anh (Personal Use)." FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                    </StackPanel>

                    <!-- Footer Copyright -->
                    <Border Grid.Row="4" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,14,0,0">
                        <TextBlock Text="Copyright © 2026 Nguyen Quoc Anh. All rights reserved." FontSize="11" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>

    </Grid>
    </Grid>
</Window>
