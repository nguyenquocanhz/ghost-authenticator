<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>logo.ico</ApplicationIcon>
    <AssemblyName>GhostAuthenticatorSetup</AssemblyName>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Authors>Nguyen Quoc Anh</Authors>
    <Company>Nguyen Quoc Anh</Company>
    <Product>Ghost Authenticator Setup</Product>
    <Copyright>Copyright © 2026 Nguyen Quoc Anh. All rights reserved.</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\bin\Release\net8.0-windows10.0.19041.0\win-x64\publish\AuthenticatorDesktop.exe" Link="AuthenticatorDesktop.exe" />
    <EmbeddedResource Include="..\asset\logo.ico" Link="logo.ico" />
  </ItemGroup>

</Project>
