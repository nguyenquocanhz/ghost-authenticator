<Window x:Class="GhostAuthenticatorSetup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ghost Authenticator Setup" Height="460" Width="620"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#07090E" Foreground="#F3F4F6">

    <Window.Resources>
        <!-- Custom UI Theme Colors -->
        <SolidColorBrush x:Key="PrimaryBlue" Color="#8B5CF6"/> <!-- Purple Theme -->
        <SolidColorBrush x:Key="BorderBrush" Color="#27272A"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#F3F4F6"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#9CA3AF"/>
        <SolidColorBrush x:Key="InputBg" Color="#18181B"/>
        <SolidColorBrush x:Key="ModalBg" Color="#0F1117"/>
        
        <!-- Standard Button Style -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#1F2937"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#374151"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Primary Action Button -->
        <Style x:Key="BtnPrimary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource PrimaryBlue}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#7C3AED"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Standard CheckBox Style -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header Brand -->
            <RowDefinition Height="*"/>    <!-- Page Content Slider -->
            <RowDefinition Height="64"/>   <!-- Bottom Actions Bar -->
        </Grid.RowDefinitions>

        <!-- Header Brand Panel -->
        <Border Grid.Row="0" Background="#0F1117" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="20,16">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <!-- Standard Shield Icon using Segoe MDL2 Assets font -->
                    <TextBlock Text="&#xE756;" FontFamily="Segoe MDL2 Assets" FontSize="24" Foreground="{StaticResource PrimaryBlue}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Trình cài đặt phần mềm" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                        <TextBlock Text="Ghost Authenticator v1.0.0" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Page Content Slider (Toggle visibility between grids) -->
        <Grid Grid.Row="1" Margin="24">
            
            <!-- STEP 1: Choose Installation Directory -->
            <Grid x:Name="Step1Panel" Visibility="Visible">
                <StackPanel>
                    <TextBlock Text="Chào mừng bạn đến với bộ cài đặt Ghost Authenticator" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
                    <TextBlock Text="Ứng dụng xác thực 2FA siêu bảo mật và ẩn danh dành riêng cho hệ điều hành Windows." FontSize="13" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,24" TextWrapping="Wrap"/>
                    
                    <TextBlock Text="Chọn thư mục cài đặt:" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtInstallPath" Grid.Column="0" Padding="12,10" Background="{StaticResource InputBg}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" FontSize="13">
                            <TextBox.Resources>
                                <Style TargetType="{x:Type Border}">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </TextBox.Resources>
                        </TextBox>
                        <Button Grid.Column="2" Content="Duyệt..." Padding="16,8" Click="BtnBrowse_Click"/>
                    </Grid>
                    
                    <TextBlock Text="* Lưu ý: Thư mục mặc định nằm trong AppData Local của người dùng để cài đặt nhanh chóng, không yêu cầu quyền Admin hệ thống." FontSize="11" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>

            <!-- STEP 2: Configure Master Password -->
            <Grid x:Name="Step2Panel" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="Thiết lập mật khẩu Master cho ứng dụng" FontSize="16" FontWeight="Bold" Margin="0,0,0,6"/>
                    <TextBlock Text="Đặt mật khẩu chính ngay để mã hóa toàn bộ cơ sở dữ liệu 2FA của bạn bằng thuật toán AES-256." FontSize="13" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,16" TextWrapping="Wrap"/>

                    <CheckBox x:Name="ChkSetupPassword" Content="Thiết lập mật khẩu Master ngay lúc này (Khuyên dùng)" IsChecked="True" Checked="ChkSetupPassword_Changed" Unchecked="ChkSetupPassword_Changed" Margin="0,0,0,14"/>

                    <StackPanel x:Name="PasswordInputsPanel">
                        <!-- Password box -->
                        <TextBlock Text="Mật khẩu chính (Mới):" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,6"/>
                        <PasswordBox x:Name="TxtNewPassword" PasswordChar="●" Padding="10,8" BorderBrush="{StaticResource BorderBrush}" Background="{StaticResource InputBg}" Foreground="White" BorderThickness="1" Margin="0,0,0,12"/>

                        <!-- Confirm password box -->
                        <TextBlock Text="Xác nhận mật khẩu chính:" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,6"/>
                        <PasswordBox x:Name="TxtConfirmPassword" PasswordChar="●" Padding="10,8" BorderBrush="{StaticResource BorderBrush}" Background="{StaticResource InputBg}" Foreground="White" BorderThickness="1" Margin="0,0,0,10"/>
                    </StackPanel>
                    
                    <TextBlock Text="* Mật khẩu của bạn được mã hóa 600.000 lượt băm PBKDF2. Vui lòng ghi nhớ cẩn thận, chúng tôi không thể phục hồi mật khẩu này nếu bạn quên." FontSize="11" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>

            <!-- STEP 3: Setup Options -->
            <Grid x:Name="Step3Panel" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="Lựa chọn các phím tắt và lối tắt" FontSize="16" FontWeight="Bold" Margin="0,0,0,6"/>
                    <TextBlock Text="Chọn các tùy chọn bổ sung mà bạn muốn cấu hình trong quá trình cài đặt." FontSize="13" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,24" TextWrapping="Wrap"/>

                    <CheckBox x:Name="ChkDesktopShortcut" Content="Tạo phím tắt ngoài Màn hình chính (Desktop Shortcut)" IsChecked="True"/>
                    <CheckBox x:Name="ChkStartShortcut" Content="Tạo lối tắt trong danh mục Start Menu" IsChecked="True"/>
                    <CheckBox x:Name="ChkRegisterUninstall" Content="Đăng ký phần mềm trong Control Panel (Add/Remove Programs)" IsChecked="True"/>
                </StackPanel>
            </Grid>

            <!-- STEP 4: Installation Progress -->
            <Grid x:Name="Step4Panel" Visibility="Collapsed" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock x:Name="TxtProgressStatus" Text="Đang bắt đầu quá trình cài đặt..." FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,15"/>
                    <!-- Progress Bar -->
                    <ProgressBar x:Name="ProgressBarInstall" Height="14" Minimum="0" Maximum="100" Value="10" Background="#1F2937" BorderThickness="0" Foreground="{StaticResource PrimaryBlue}">
                        <ProgressBar.Resources>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="CornerRadius" Value="7"/>
                            </Style>
                        </ProgressBar.Resources>
                    </ProgressBar>
                    <TextBlock x:Name="TxtProgressPercent" Text="10%" FontSize="12" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                </StackPanel>
            </Grid>

            <!-- STEP 5: Installation Complete Success -->
            <Grid x:Name="Step5Panel" Visibility="Collapsed">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <!-- Icon success -->
                    <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="56" Foreground="#10B981" HorizontalAlignment="Center" Margin="0,0,0,15"/>
                    
                    <TextBlock Text="Cài đặt hoàn tất thành công!" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock Text="Ghost Authenticator đã được thiết lập thành công trên máy tính của bạn." FontSize="13" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" Margin="0,0,0,24"/>

                    <CheckBox x:Name="ChkLaunchApp" Content="Khởi chạy Ghost Authenticator ngay bây giờ" IsChecked="True" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>

        </Grid>

        <!-- Bottom Actions Bar -->
        <Border Grid.Row="2" Background="#0F1117" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="20,12">
            <Grid>
                <!-- Back Button -->
                <Button x:Name="BtnBack" Content="Quay lại" HorizontalAlignment="Left" Visibility="Collapsed" Click="BtnBack_Click"/>
                
                <!-- Next / Cancel Buttons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnCancel" Content="Hủy bỏ" Margin="0,0,10,0" Click="BtnCancel_Click"/>
                    <Button x:Name="BtnNext" Content="Tiếp tục" IsDefault="True" Style="{StaticResource BtnPrimary}" Click="BtnNext_Click"/>
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</Window>
